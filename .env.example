# Copy to .env and fill in. NEVER commit .env.
# Get from https://tokenfactory.nebius.com/ -> API Keys
NEBIUS_API_KEY=

# Optional - only needed for Sandboxes (shown in Token Factory console)
NEBIUS_PROJECT_ID=

# Optional - from the Nebius Builders Program, or https://app.tavily.com/
TAVILY_API_KEY=
